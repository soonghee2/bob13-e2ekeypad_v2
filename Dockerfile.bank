FROM gradle:8.5-jdk21 AS builder
WORKDIR /workspace

COPY gradlew gradlew.bat settings.gradle.kts build.gradle.kts gradle.properties ./
COPY gradle ./gradle
COPY bank-server ./bank-server

RUN ./gradlew --no-daemon :bank-server:bootJar

FROM eclipse-temurin:21-jre AS runtime
WORKDIR /app

ENV BANK_SERVER_PORT=8081

COPY --from=builder /workspace/bank-server/build/libs/*-SNAPSHOT.jar /app/app.jar

EXPOSE 8081

ENTRYPOINT ["sh", "-c", "java -jar /app/app.jar --server.port=${BANK_SERVER_PORT}"]
